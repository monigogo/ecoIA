# --- App identity ---
APP_NAME=ecoIA
APP_ENV=development
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- LLM ---
LLM_PROVIDER=nvidia
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
# Legacy OpenAI-compatible env vars are still accepted for migration.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Storage ---
DATABASE_URL=sqlite:///./solarlife.db
MEMORY_STORAGE_BACKEND=sqlite
AGENT_CHECKPOINT_SQLITE_PATH=./.data/langgraph_checkpoints.sqlite
DISKCACHE_DIR=./.cache

# --- External APIs ---
PVGIS_BASE_URL=https://re.jrc.ec.europa.eu/api/v5_3
BDNS_BASE_URL=https://www.infosubvenciones.es/bdnstrans/api
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=solarlife-backend
GEOCODING_CACHE_TTL_SECONDS=86400
GEOCODING_MIN_INTERVAL_SECONDS=1.0

# --- Energy price providers ---
ESIOS_API_BASE_URL=https://api.esios.ree.es
ESIOS_API_TOKEN=
# Indicator id for PVPC simplified surplus compensation (1739).
ESIOS_INDICATOR_PVPC_SURPLUS_COMPENSATION=1739
# Indicator id for PVPC import reference price (configure explicitly; no opaque default).
ESIOS_INDICATOR_PVPC_IMPORT_REFERENCE=
OMIE_BASE_URL=https://www.omie.es
PRICE_PROVIDER_TIMEOUT_SECONDS=30

# --- Subsidy / tax-benefit providers ---
BDNS_API_BASE_URL=https://www.infosubvenciones.es/bdnstrans/api
BDNS_SWAGGER_URL=https://www.infosubvenciones.es/bdnstrans/doc/swagger
IDAE_BASE_URL=https://www.idae.es
AEAT_BASE_URL=https://sede.agenciatributaria.gob.es
SUBSIDY_PROVIDER_TIMEOUT_SECONDS=30

# --- HTTP ---
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# --- Agent runtime ---
AGENT_MODEL_CALL_LIMIT=24
AGENT_TOOL_CALL_LIMIT=32
AGENT_TASK_CALL_LIMIT=8
AGENT_RUNTIME_TIMEOUT_SECONDS=1000
AGENT_ASSUMPTION_TOOL_TIMEOUT_SECONDS=60
AGENT_SOLAR_BASE_SCENARIO_TOOL_TIMEOUT_SECONDS=90
AGENT_PVGIS_TOOL_TIMEOUT_SECONDS=45
AGENT_SUBSIDY_TOOL_TIMEOUT_SECONDS=60
AGENT_PII_GUARDRAILS_ENABLED=true
AGENT_PROMPT_GUARDRAILS_ENABLED=true
AGENT_OUTPUT_GUARDRAILS_ENABLED=true
AGENT_HUMAN_IN_THE_LOOP_ENABLED=false
AGENT_HUMAN_IN_THE_LOOP_TOOLS=[]

# --- Tracing ---
TRACE_ENABLED=true
